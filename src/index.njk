---
permalink: /index.html
---
{#-
  Every value below comes from config.yaml and is rendered through Nunjucks
  autoescaping. Nothing is marked `| safe`: icons are drawn from validated
  path data, never from raw markup. See SECURITY.md.
-#}
{%- macro icon(data) -%}
<svg class="icon{% if not data.fill %} icon--stroke{% endif %}" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">{% for d in data.paths %}<path d="{{ d }}"/>{% endfor %}</svg>
{%- endmacro -%}
<!doctype html>
<html lang="{{ site.lang }}"{% if site.theme.mode != 'auto' %} data-theme="{{ site.theme.mode }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#- GitHub Pages cannot set response headers, so the policy ships as a meta tag. -#}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' https:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
    <meta name="referrer" content="no-referrer">
    <meta name="color-scheme" content="{{ 'light dark' if site.theme.mode == 'auto' else site.theme.mode }}">

    <title>{{ site.seo.title }}</title>
    <meta name="description" content="{{ site.seo.description }}">
    {%- if site.canonical %}
    <link rel="canonical" href="{{ site.canonical }}">
    {%- endif %}

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.seo.title }}">
    <meta property="og:description" content="{{ site.seo.description }}">
    {%- if site.ogImage %}
    <meta property="og:image" content="{{ site.ogImage }}">
    <meta name="twitter:card" content="summary_large_image">
    {%- else %}
    <meta name="twitter:card" content="summary">
    {%- endif %}

    {%- if site.profile.avatar %}
    <link rel="icon" href="{{ site.profile.avatar }}">
    {%- endif %}
    <link rel="preload" href="assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="styles.css">
    {#- Not deferred: it applies the saved theme before the first paint. -#}
    <script src="theme.js"></script>
  </head>

  <body>
    {%- if site.agenda.length %}
    <a class="skip-link" href="#agenda">Pular para a agenda</a>
    {%- elif site.links.length %}
    <a class="skip-link" href="#links">Pular para os links</a>
    {%- endif %}


    {#- The dot field sits behind everything and never takes a pointer. -#}
    <div class="backdrop" aria-hidden="true"></div>

    <div class="frame">
      {#- Revealed by theme.js; without JavaScript it would be a dead control. -#}
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        hidden
        aria-pressed="false"
        aria-label="Mudar para o tema escuro"
        data-label-dark="Mudar para o tema escuro"
        data-label-light="Mudar para o tema claro"
      >
        <svg class="icon icon--stroke theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z"/>
          <path d="M12 2v2"/><path d="M12 20v2"/><path d="M4 12H2"/><path d="M22 12h-2"/>
          <path d="m5.6 5.6 1.4 1.4"/><path d="m17 17 1.4 1.4"/><path d="m18.4 5.6-1.4 1.4"/><path d="m7 17-1.4 1.4"/>
        </svg>
        <svg class="icon icon--stroke theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <header class="profile">
        {%- if site.profile.avatar %}
        <img class="avatar avatar--{{ site.profile.avatar_shape }}" src="{{ site.profile.avatar }}" width="112" height="112" alt="{{ site.profile.name }}">
        {%- else %}
        <p class="avatar avatar--{{ site.profile.avatar_shape }} avatar--initials" aria-hidden="true">{{ site.initials }}</p>
        {%- endif %}
        <h1>{{ site.profile.name }}</h1>

        {%- if site.profile.handle %}
        <p class="handle">
          {%- if site.profile.handle_url -%}
          <a href="{{ site.profile.handle_url }}" target="_blank" rel="noopener noreferrer">{{ site.profile.handle }}</a>
          {%- else -%}
          {{ site.profile.handle }}
          {%- endif -%}
        </p>
        {%- endif %}

        {%- if site.profile.tagline %}
        <p class="tagline">{{ site.profile.tagline }}</p>
        {%- endif %}

        {%- if site.social.length %}
        <nav class="social" aria-label="Contato e redes sociais">
          <ul>
            {%- for entry in site.social %}
            <li>
              <a class="social__link" href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">
                {{ icon(entry.iconData) }}
                <span class="visually-hidden">{{ entry.iconData.title }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </nav>
        {%- endif %}
      </header>

      <main>
        <section class="agenda" id="agenda" aria-labelledby="agenda-title">
          <h2 class="agenda__title" id="agenda-title">Programação</h2>

          {%- if site.agenda.length %}
          {%- for day in site.agenda %}
          <section class="day" aria-label="{{ day.heading.full }}">
            <p class="day__rail">
              <span class="day__weekday">{{ day.heading.weekday }}</span>
              <span class="day__number">{{ day.heading.day }}</span>
              <span class="day__month">{{ day.heading.month }}</span>
            </p>

            <ol class="day__entries">
              {%- for event in day.events %}
              <li class="entry{% if event.featured %} entry--featured{% endif %}">
                <div class="entry__text">
                  <p class="entry__time">
                    <time datetime="{{ event.iso }}">{{ event.time if event.time else 'Dia todo' }}</time>
                  </p>
                  <h3 class="entry__title">
                    {%- if event.url -%}
                    <a class="entry__link" href="{{ event.url }}" target="_blank" rel="noopener noreferrer">{{ event.title }}</a>
                    {%- else -%}
                    {{ event.title }}
                    {%- endif -%}
                  </h3>
                  <p class="entry__meta">
                    {%- if event.kind %}<span class="entry__kind">{{ event.kind }}</span>{% endif %}
                    {%- if event.runsUntil %}<span class="entry__until">até {{ event.runsUntil }}</span>{% endif %}
                  </p>
                  {%- if event.featured and event.description %}
                  <p class="entry__description">{{ event.description }}</p>
                  {%- endif %}
                </div>

                {%- if event.image %}
                {#- The frame clips; the image drifts inside it as the page scrolls. -#}
                <div class="entry__media">
                  <img class="entry__image" src="{{ event.image }}" width="256" height="256" alt="" loading="lazy" decoding="async">
                </div>
                {%- endif %}
              </li>
              {%- endfor %}
            </ol>
          </section>
          {%- endfor %}
          {%- else %}
          <p class="empty">Nenhum evento publicado no momento. Os canais oficiais abaixo têm a programação atual.</p>
          {%- endif %}
        </section>

        {%- if site.links.length %}
        <section class="more" id="links" aria-labelledby="links-title">
          <h2 class="more__title" id="links-title">Páginas oficiais</h2>
          <ul class="links">
            {%- for link in site.links %}
            <li>
              <a class="link{% if link.highlight %} link--highlight{% endif %}" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
                {%- if link.iconData %}{{ icon(link.iconData) }}{% endif %}
                <span class="link__label">{{ link.label }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </section>
        {%- endif %}
      </main>

      {%- if site.footer %}
      {%- set footerTag = 'a' if site.footer.url else 'div' %}
      <footer class="footer">
        <{{ footerTag }} class="footer__inner"{% if site.footer.url %} href="{{ site.footer.url }}" target="_blank" rel="noopener noreferrer"{% endif %}>
          {%- if site.footer.logos.length %}
          <span class="footer__logos">
            {%- for mark in site.footer.logos %}
            {#- Without its own alt a mark is decorative: the caption below names the owner. -#}
            <img class="footer__logo" src="{{ mark.image }}" width="88" height="32" alt="{{ mark.alt if mark.alt else '' }}">
            {%- endfor %}
          </span>
          {%- endif %}
          {%- if site.footer.text %}<span class="footer__text">{{ site.footer.text }}</span>{% endif %}
        </{{ footerTag }}>
      </footer>
      {%- endif %}
    </div>
  </body>
</html>
