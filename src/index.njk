---
permalink: /index.html
---
{#-
  Every value below comes from config.yaml and is rendered through Nunjucks
  autoescaping. Icons are drawn from validated path data, never from raw
  markup. See SECURITY.md.

  One value is marked `| safe`, and only one: the JSON-LD block. A <script>
  element holds raw text, so escaping it would corrupt the JSON instead of
  protecting anything. It is serialised in src/_data/site.js with <, > and &
  written as unicode escapes, which JSON reads as the same characters and the
  HTML parser cannot read as markup at all.
-#}
{%- macro icon(data) -%}
<svg class="icon{% if not data.fill %} icon--stroke{% endif %}" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">{% for d in data.paths %}<path d="{{ d }}"/>{% endfor %}</svg>
{%- endmacro -%}
{%- macro clockIcon() -%}
<svg class="icon icon--stroke" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- endmacro -%}
{%- macro calendarIcon() -%}
<svg class="icon icon--stroke" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/></svg>
{%- endmacro -%}
<!doctype html>
<html lang="{{ site.lang }}"{% if site.theme.mode != 'auto' %} data-theme="{{ site.theme.mode }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#- GitHub Pages cannot set response headers, so the policy ships as a meta tag.
        frame-ancestors is left out on purpose: a meta tag cannot deliver it, and
        including it only logged an error in every visitor's console. See SECURITY.md. -#}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' https:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
    <meta name="referrer" content="no-referrer">
    <meta name="color-scheme" content="{{ 'light dark' if site.theme.mode == 'auto' else site.theme.mode }}">
    {#- Pinta a barra do navegador no celular com a cor do cartão. -#}
    <meta name="theme-color" content="{{ site.surface.light }}" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="{{ site.surface.dark }}" media="(prefers-color-scheme: dark)">

    <title>{{ site.seo.title }}</title>
    <meta name="description" content="{{ site.seo.description }}">
    {%- if site.canonical %}
    <link rel="canonical" href="{{ site.canonical }}">
    {%- endif %}

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.seo.title }}">
    <meta property="og:description" content="{{ site.seo.description }}">
    <meta property="og:site_name" content="{{ site.profile.name }}">
    <meta property="og:locale" content="{{ site.lang | replace('-', '_') }}">
    {%- if site.canonical %}
    <meta property="og:url" content="{{ site.canonical }}">
    {%- endif %}
    {%- if site.ogImage %}
    <meta property="og:image" content="{{ site.ogImage }}">
    <meta property="og:image:alt" content="{{ site.profile.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image:alt" content="{{ site.profile.name }}">
    {%- else %}
    <meta name="twitter:card" content="summary">
    {%- endif %}

    {%- if site.profile.avatar %}
    <link rel="icon" href="{{ site.profile.avatar }}">
    {%- endif %}
    <link rel="preload" href="assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="styles.css">
    {%- if site.agenda.length %}
    {#- Deixa a agenda descobrível sem precisar caçar o link na página. -#}
    <link rel="alternate" type="text/calendar" href="agenda.ics" title="Agenda do {{ site.profile.name }}">
    {%- endif %}
    {#- Not deferred: it applies the saved theme before the first paint. -#}
    <script src="theme.js"></script>
    {#- Com defer: nada aqui precisa acontecer antes da primeira pintura. -#}
    <script src="compartilhar.js" defer></script>
    {%- if site.structuredData %}
    {#- A data block, not executable script: CSP script-src does not apply. -#}
    <script type="application/ld+json">{{ site.structuredData | safe }}</script>
    {%- endif %}
  </head>

  <body>
    {%- if site.agenda.length %}
    <a class="skip-link" href="#agenda">Pular para a agenda</a>
    {%- elif site.links.length %}
    <a class="skip-link" href="#links">Pular para os links</a>
    {%- endif %}


    {#- The dot field sits behind everything and never takes a pointer. -#}
    <div class="backdrop" aria-hidden="true"></div>

    <div class="frame">
      <header class="profile{% if site.profile.hero %} profile--hero{% endif %}">
      <div class="acoes">
      {#- Revealed by theme.js; without JavaScript it would be a dead control. -#}
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        hidden
        aria-pressed="false"
        aria-label="Mudar para o tema escuro"
        data-label-dark="Mudar para o tema escuro"
        data-label-light="Mudar para o tema claro"
      >
        {#- Sun and moon in one mark: the disc is a crescent inside the rays,
             so the button looks the same in both themes and only its label
             changes. -#}
        <svg class="icon icon--stroke" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"/>
          <path d="M12 2v2"/><path d="M12 20v2"/><path d="M4 12H2"/><path d="M22 12h-2"/>
          <path d="m5.6 5.6 1.4 1.4"/><path d="m17 17 1.4 1.4"/><path d="m18.4 5.6-1.4 1.4"/><path d="m7 17-1.4 1.4"/>
        </svg>
      </button>

      {#- Escondido até o script confirmar que o navegador sabe compartilhar ou
          copiar; senão seria um botão que não faz nada. -#}
      <button
        id="compartilhar"
        class="theme-toggle"
        type="button"
        hidden
        aria-label="Compartilhar esta página"
        data-titulo="{{ site.seo.title }}"
        data-texto="{{ site.seo.description }}"
        {% if site.canonical %}data-url="{{ site.canonical }}"{% endif %}
        data-copiado="Endereço copiado"
        data-falhou="Não consegui copiar o endereço"
      >
        <svg class="icon icon--stroke" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M12 2v13"/>
          <path d="m8 6 4-4 4 4"/>
          <path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7"/>
        </svg>
      </button>
      <p id="compartilhar-aviso" class="visually-hidden" role="status" aria-live="polite"></p>
      </div>
        {#- A faixa do topo já traz o nome do museu desenhado. Repetir o mesmo
            nome em texto logo abaixo seria dizer a mesma coisa duas vezes, então
            o h1 fica só para quem lê por leitor de tela e para os buscadores. O
            alt da imagem fica vazio pelo mesmo motivo: o h1 ao lado já anuncia
            o nome, e um alt repetido faria o leitor dizer tudo em dobro. -#}
        {%- if site.profile.hero %}
        <img class="hero" src="{{ site.profile.hero }}" width="1600" height="800" alt="" fetchpriority="high">
        {%- elif site.profile.avatar %}
        <img class="avatar avatar--{{ site.profile.avatar_shape }}" src="{{ site.profile.avatar }}" width="112" height="112" alt="{{ site.profile.name }}">
        {%- else %}
        <p class="avatar avatar--{{ site.profile.avatar_shape }} avatar--initials" aria-hidden="true">{{ site.initials }}</p>
        {%- endif %}
        <h1{% if site.profile.hero %} class="visually-hidden"{% endif %}>{{ site.profile.name }}</h1>

        {%- if site.profile.handle %}
        <p class="handle">
          {%- if site.profile.handle_url -%}
          <a href="{{ site.profile.handle_url }}" target="_blank" rel="noopener noreferrer">{{ site.profile.handle }}</a>
          {%- else -%}
          {{ site.profile.handle }}
          {%- endif -%}
        </p>
        {%- endif %}

        {%- if site.profile.tagline %}
        <p class="tagline">{{ site.profile.tagline }}</p>
        {%- endif %}

        {%- if site.social.length %}
        <nav class="social" aria-label="Contato e redes sociais">
          <ul>
            {%- for entry in site.social %}
            <li>
              <a class="social__link" href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">
                {{ icon(entry.iconData) }}
                <span class="visually-hidden">{{ entry.iconData.title }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </nav>
        {%- endif %}

        {%- if site.hours.length %}
        {#- <dl> porque é exatamente isto: o dia é o termo, a hora é o que ele
            define. Cada par vem dentro de um <div> para poder virar uma linha
            de grade sem quebrar a associação entre <dt> e <dd>. -#}
        <section class="horario" aria-labelledby="horario-titulo">
          <h2 class="horario__titulo" id="horario-titulo">
            {{- clockIcon() }}<span>Horário de funcionamento</span>
          </h2>
          <dl class="horario__lista">
            {%- for faixa in site.hours %}
            <div class="horario__faixa">
              <dt class="horario__dias">
                {{ faixa.days }}
                {%- if faixa.note %}<span class="horario__nota">{{ faixa.note }}</span>{% endif %}
              </dt>
              <dd class="horario__hora">{{ faixa.time }}</dd>
            </div>
            {%- endfor %}
          </dl>
        </section>
        {%- endif %}
      </header>

      <main>
        <section class="agenda" id="agenda" aria-labelledby="agenda-title">
          <div class="agenda__head">
            <h2 class="agenda__title" id="agenda-title">Programação</h2>
            {%- if site.agenda.length %}
            <a class="agenda__subscribe" href="agenda.ics" download>
              {{- calendarIcon() }}<span>Assinar a agenda</span>
            </a>
            {%- endif %}
          </div>

          {%- if site.agenda.length %}
          {%- for day in site.agenda %}
          <section class="day" aria-label="{{ day.heading.full }}">
            {#- A data completa já está no aria-label da seção; sem isto o
                leitor de tela anunciava "seg. 21 set." logo depois dela. -#}
            <p class="day__rail" aria-hidden="true">
              <span class="day__weekday">{{ day.heading.weekday }}</span>
              <span class="day__number">{{ day.heading.day }}</span>
              <span class="day__month">{{ day.heading.month }}</span>
            </p>

            <ol class="day__entries">
              {%- for event in day.events %}
              <li>
                {#- Um evento é conteúdo autocontido: sai da agenda e continua
                    fazendo sentido sozinho, que é o que <article> significa. -#}
                <article class="entry">
                  <div class="entry__text">
                  <p class="entry__time">
                    <time datetime="{{ event.iso }}">{{ event.time if event.time else 'Dia todo' }}</time>
                  </p>
                  <h3 class="entry__title">
                    {%- if event.url -%}
                    <a class="entry__link" href="{{ event.url }}" target="_blank" rel="noopener noreferrer">{{ event.title }}</a>
                    {%- else -%}
                    {{ event.title }}
                    {%- endif -%}
                  </h3>
                  <p class="entry__meta">
                    {%- if event.kind %}<span class="entry__kind">{{ event.kind }}</span>{% endif %}
                    {%- if event.runsUntil %}<span class="entry__until">até {{ event.runsUntil }}</span>{% endif %}
                  </p>
                  {%- if event.description %}
                  <p class="entry__description">{{ event.description }}</p>
                  {%- endif %}
                </div>

                  <div class="entry__lado">
                    {%- if event.image %}
                    {#- A moldura recorta; a foto desliza dentro dela ao rolar. -#}
                    <div class="entry__media">
                      <img class="entry__image" src="{{ event.image }}" width="256" height="256" alt="" loading="lazy" decoding="async">
                    </div>
                    {%- endif %}
                    {#- Só o ícone, com rótulo no aria-label: com texto, cada cartão
                        ganhava uma linha inteira e a agenda voltava a caber um
                        evento por tela de celular. -#}
                    <a
                      class="entry__calendar"
                      href="eventos/{{ event.slug }}.ics"
                      download
                      aria-label="Adicionar “{{ event.title }}” ao calendário"
                    >{{ calendarIcon() }}</a>
                  </div>

                </article>
              </li>
              {%- endfor %}
            </ol>
          </section>
          {%- endfor %}
          {%- else %}
          <p class="empty">
            Nenhuma atividade marcada por enquanto. As páginas oficiais logo abaixo
            trazem a programação em cartaz.
          </p>
          {%- endif %}
        </section>

        {%- if site.links.length %}
        <section class="more" id="links" aria-labelledby="links-title">
          <h2 class="more__title" id="links-title">Páginas oficiais</h2>
          <ul class="links">
            {%- for link in site.links %}
            <li>
              <a class="link{% if link.highlight %} link--highlight{% endif %}" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
                {%- if link.iconData %}{{ icon(link.iconData) }}{% endif %}
                <span class="link__label">{{ link.label }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </section>
        {%- endif %}
      </main>

      <footer class="footer">
      {%- if site.footer %}
      {%- set footerTag = 'a' if site.footer.url else 'div' %}
        <{{ footerTag }} class="footer__inner"{% if site.footer.url %} href="{{ site.footer.url }}" target="_blank" rel="noopener noreferrer"{% endif %}>
          {%- if site.footer.logos.length %}
          <span class="footer__logos">
            {%- for mark in site.footer.logos %}
            {#- Without its own alt a mark is decorative: the caption below names the owner. -#}
            <img class="footer__logo" src="{{ mark.image }}" width="88" height="32" alt="{{ mark.alt if mark.alt else '' }}">
            {%- endfor %}
          </span>
          {%- endif %}
          {%- if site.footer.text %}<span class="footer__text">{{ site.footer.text }}</span>{% endif %}
        </{{ footerTag }}>
        {%- endif %}
      </footer>
    </div>
  </body>
</html>
