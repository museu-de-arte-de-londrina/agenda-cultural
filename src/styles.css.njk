/*
  Generated at build time so `theme.accent` can be baked in as a custom
  property. Shipping it as a real file (instead of an inline <style>) is what
  lets the CSP stay at `style-src 'self'` with no 'unsafe-inline'.

  Theme resolution, in order of precedence:
    1. :root[data-theme="..."]  — the toggle, and theme.mode when it is fixed
    2. prefers-color-scheme     — the reader's system setting
    3. :root                    — light, the base every token is defined in
*/

/* Archivo, by Omnibus-Type (Buenos Aires). Self-hosted: no request ever
   leaves for a font CDN, so no visitor IP is handed to a third party.
   Licence in assets/fonts/OFL.txt. */
@font-face {
  font-family: 'Archivo';
  src: url('assets/fonts/archivo-latin.woff2') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
    U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Archivo';
  src: url('assets/fonts/archivo-latin-ext.woff2') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308,
    U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
    U+2C60-2C7F, U+A720-A7FF;
}

:root {
  color-scheme: light;

  --accent: {{ site.theme.accent }};
  --accent-fg: {{ site.accentForeground }};

  /* Cool paper and blue-cast greys: the museum is Artigas concrete, not linen. */
  --bg: #eef2f7;
  --surface: #ffffff;
  --surface-2: #f5f8fc;
  --surface-hover: #e8eef7;
  --text: #0c1220;
  --muted: #4d5c73;
  --border: #d8e0ec;
  --hairline: #e7ecf4;
  --dot: rgba(0, 64, 128, 0.16);
  --accent-text: {{ site.accentText.light }};
  --focus: {{ site.focusRing.light }};

  /* Depth is a scale, not one shadow reused everywhere. Tinted with the ink
     of the palette so shadows belong to the page instead of greying it. */
  --shadow-1: 0 1px 2px rgba(12, 18, 32, 0.06);
  --shadow-2: 0 2px 4px rgba(12, 18, 32, 0.05), 0 8px 20px rgba(12, 18, 32, 0.06);
  --shadow-3: 0 4px 10px rgba(12, 18, 32, 0.06), 0 24px 60px rgba(12, 18, 32, 0.1);
  /* Top-edge highlight: what makes a raised surface read as lit from above. */
  --ring: inset 0 1px 0 rgba(255, 255, 255, 0.9);

  --display: 'Archivo', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  /* Archivo sets a narrow word space for its width; without this, titles read
     as one long word at display sizes. */
  --display-word-spacing: 0.06em;
  --body: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

{% set darkTokens %}
  color-scheme: dark;
  --bg: #060a13;
  --surface: #0d1524;
  --surface-2: #121c2f;
  --surface-hover: #1a2540;
  --text: #e9eff8;
  --muted: #9db0cb;
  --border: #22304a;
  --hairline: #1a2438;
  --dot: rgba(112, 176, 224, 0.16);
  --accent-text: {{ site.accentText.dark }};
  --focus: {{ site.focusRing.dark }};
  --shadow-1: 0 1px 2px rgba(0, 0, 0, 0.5);
  --shadow-2: 0 2px 4px rgba(0, 0, 0, 0.45), 0 8px 20px rgba(0, 0, 0, 0.5);
  --shadow-3: 0 4px 10px rgba(0, 0, 0, 0.5), 0 24px 60px rgba(0, 0, 0, 0.6);
  --ring: inset 0 1px 0 rgba(255, 255, 255, 0.07);
{% endset %}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    {{- darkTokens -}}
  }
}

:root[data-theme='dark'] {
  {{- darkTokens -}}
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 1.25rem 0.875rem 3rem;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  font-size: 1rem;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}

/* The dot field the page floats above. Fixed so it does not slide with the
   content, masked so it fades out instead of tiling to the edges. */
.backdrop {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: radial-gradient(circle at center, var(--dot) 1.4px, transparent 1.5px);
  background-size: 22px 22px;
  -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, #000 35%, transparent 100%);
  mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, #000 35%, transparent 100%);
}

/* Keyboard users get here first; it stays off-screen until focused. */
.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  padding: 0.75rem 1rem;
  background: var(--surface);
  color: var(--text);
  border-radius: 0 0 0.5rem 0;
  box-shadow: var(--shadow-2);
}

.skip-link:focus {
  left: 0;
  z-index: 3;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ---------------------------------------------------------------- toggle -- */

.theme-toggle {
  position: fixed;
  top: 0.75rem;
  right: 0.75rem;
  z-index: 2;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
  color: var(--muted);
  box-shadow: var(--shadow-2), var(--ring);
  cursor: pointer;
}

.theme-toggle:hover {
  color: var(--text);
  background: var(--surface-hover);
}

/* One icon per theme, both in the same grid cell so the button never resizes. */
.theme-toggle__sun,
.theme-toggle__moon {
  grid-area: 1 / 1;
}

.theme-toggle__sun {
  display: none;
}

:root[data-theme='dark'] .theme-toggle__sun {
  display: block;
}

:root[data-theme='dark'] .theme-toggle__moon {
  display: none;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) .theme-toggle__sun {
    display: block;
  }

  :root:not([data-theme='light']) .theme-toggle__moon {
    display: none;
  }
}

/* ----------------------------------------------------------------- frame -- */

/* The one surface that lifts off the dot field. Everything inside it is flat
   by default, so the page has a single, readable elevation story. */
.frame {
  width: 100%;
  max-width: 46rem;
  margin: 0 auto;
  padding: 1.5rem 1.125rem 1.25rem;
  border: 1px solid var(--border);
  border-radius: 1.5rem;
  background: var(--surface);
  box-shadow: var(--shadow-3), var(--ring);
}

/* -------------------------------------------------------------- masthead -- */

.profile {
  display: grid;
  justify-items: center;
  gap: 0.5rem;
  text-align: center;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--hairline);
}

.avatar {
  width: 4rem;
  height: 4rem;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-1);
}

.avatar--circle {
  border-radius: 50%;
  object-fit: cover;
}

/* Logos carry a wordmark that a circle would crop, so they get a box and are
   contained rather than cropped. The plate follows the theme, so a logo with
   its own background fills the box and one without still sits on a surface. */
.avatar--square {
  border-radius: 0.875rem;
  object-fit: contain;
  background: var(--surface);
}

.avatar--initials {
  display: grid;
  place-items: center;
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1.75rem;
  font-weight: 600;
  color: var(--accent-fg);
  background: var(--accent);
  border-color: transparent;
}

h1 {
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: clamp(1.375rem, 5.5vw, 1.75rem);
  font-weight: 600;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.handle {
  margin: -0.375rem 0 0;
  font-size: 0.9375rem;
  overflow-wrap: anywhere;
}

.handle a {
  color: var(--muted);
  text-decoration: none;
}

.handle a:hover {
  color: var(--accent-text);
  text-decoration: underline;
}

.tagline {
  margin: 0;
  max-width: 34rem;
  color: var(--muted);
  font-size: 0.875rem;
  overflow-wrap: anywhere;
}

/* Compact contact row: the agenda below is the point of the page. */
.social ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.25rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.social__link {
  display: grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  color: var(--muted);
  text-decoration: none;
}

.social__link:hover {
  color: var(--accent-text);
  background: var(--surface-hover);
}

/* ---------------------------------------------------------------- agenda -- */

.agenda {
  padding-top: 1rem;
}

.agenda__title,
.more__title {
  margin: 0 0 1rem;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1.125rem;
  font-weight: 600;
}

.empty {
  margin: 0;
  color: var(--muted);
}

/* Day is the unit of the agenda. The date is printed once, on the rail, and
   the entries under it only have to say what time they start. */
.day {
  display: grid;
  grid-template-columns: 2.75rem 1fr;
  gap: 0.875rem;
}

.day + .day {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--hairline);
}

.day__rail {
  position: sticky;
  top: 0.75rem;
  align-self: start;
  margin: 0.75rem 0 0;
  display: grid;
  justify-items: center;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  line-height: 1.05;
  color: var(--muted);
}

.day__weekday,
.day__month {
  font-size: 0.6875rem;
  font-weight: 600;
}

.day__number {
  font-size: 1.5rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.day__entries {
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Rows, not cards: hairlines carry the rhythm, so fourteen events stay
   scannable instead of becoming fourteen identical boxes. */
.entry {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.875rem;
  padding: 0.75rem 0;
  align-items: start;
}

.entry:has(.entry__image) {
  grid-template-columns: 1fr auto;
}

.entry + .entry {
  border-top: 1px solid var(--hairline);
}

.entry__text {
  min-width: 0;
}

.entry__time {
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 0.8125rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--accent-text);
}

.entry__title {
  margin: 0.125rem 0 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1.0625rem;
  font-weight: 600;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.entry__link {
  color: inherit;
  text-decoration: none;
}

.entry__link:hover {
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

/* The whole row is the target, so a pointer anywhere on it opens the link. */
.entry__link::after {
  content: '';
  position: absolute;
  inset: 0;
}

.entry__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0.3125rem 0 0;
  font-size: 0.8125rem;
  color: var(--muted);
}

/* A rule, not a middle dot: the separator is structure, and it disappears
   when there is only one piece of metadata to show. */
.entry__until {
  padding-left: 0.5rem;
  border-left: 1px solid var(--border);
}

.entry__image {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 0.5rem;
  object-fit: cover;
  background: var(--surface-hover);
  box-shadow: var(--shadow-1);
}

/* The next thing happening is the only card on the page. One raised element
   is enough to say "start here". */
.entry--featured {
  margin: 0.25rem 0 0.5rem;
  padding: 0.875rem;
  border: 1px solid var(--border);
  border-radius: 0.875rem;
  background: var(--surface-2);
  box-shadow: var(--shadow-2), var(--ring);
}

.entry--featured + .entry {
  border-top: 0;
}

.entry--featured .entry__title {
  font-size: 1.1875rem;
}

.entry--featured .entry__image {
  width: 4.5rem;
  height: 4.5rem;
}

.entry__description {
  margin: 0.5rem 0 0;
  font-size: 0.875rem;
  color: var(--muted);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ----------------------------------------------------------------- links -- */

.more {
  margin-top: 1.75rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--hairline);
}

.links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.5rem;
}

.link {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  min-height: 2.875rem;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 0.625rem;
  background: var(--surface);
  color: inherit;
  font-size: 0.9375rem;
  text-decoration: none;
}

.link:hover {
  background: var(--surface-hover);
  border-color: var(--accent-text);
}

.link--highlight {
  background: var(--accent);
  border-color: transparent;
  color: var(--accent-fg);
  box-shadow: var(--shadow-2);
}

.link--highlight:hover {
  background: var(--accent);
  border-color: transparent;
  filter: brightness(0.94);
}

.link__label {
  overflow-wrap: anywhere;
}

/* ---------------------------------------------------------------- footer -- */

.footer {
  margin-top: 1.75rem;
  padding-top: 1.125rem;
  border-top: 1px solid var(--hairline);
  text-align: center;
}

.footer__inner {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  color: var(--muted);
  font-size: 0.8125rem;
  text-decoration: none;
}

a.footer__inner:hover {
  color: var(--text);
  background: var(--surface-hover);
}

/* Fixed box, image contained inside it: the slot is reserved before the
   image loads, so no layout shift, whatever logo the config points at. */
.footer__logo {
  width: 8rem;
  height: 2rem;
  object-fit: contain;
  /* The city mark is dark artwork on transparency; it needs a light plate to
     stay legible when the page renders dark. */
  background: #ffffff;
  border-radius: 0.25rem;
  padding: 0.25rem 0.5rem;
  box-sizing: content-box;
}

/* ----------------------------------------------------------------- icons -- */

.icon {
  flex: none;
  fill: currentColor;
}

.icon--stroke {
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
  border-radius: 0.25rem;
}

/* ------------------------------------------------------------ responsive -- */

@media (min-width: 34rem) {
  body {
    padding: 2.5rem 1.5rem 4rem;
  }

  .frame {
    padding: 1.75rem 1.75rem 1.5rem;
  }

  /* The masthead goes horizontal so the agenda starts higher on the page. */
  .profile {
    grid-template-columns: auto 1fr;
    justify-items: start;
    text-align: left;
    gap: 0.375rem 1.25rem;
    align-items: center;
  }

  .avatar {
    grid-row: 1 / span 4;
    width: 5.5rem;
    height: 5.5rem;
  }

  .social ul {
    justify-content: flex-start;
  }

  .day {
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
  }

  .entry__image {
    width: 4rem;
    height: 4rem;
  }

  .entry--featured .entry__image {
    width: 5.5rem;
    height: 5.5rem;
  }
}

@media (prefers-reduced-motion: no-preference) {
  .link,
  .social__link,
  .theme-toggle,
  .entry__link {
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease,
      filter 150ms ease;
  }
}
