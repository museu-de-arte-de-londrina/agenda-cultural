---
permalink: /styles.css
---
/*
  Generated at build time so `theme.accent` can be baked in as a custom
  property. Shipping it as a real file (instead of an inline <style>) is what
  lets the CSP stay at `style-src 'self'` with no 'unsafe-inline'.

  Theme resolution, in order of precedence:
    1. :root[data-theme="..."]  the toggle, and theme.mode when it is fixed
    2. prefers-color-scheme     the reader's system setting
    3. :root                    light, the base every token is defined in
*/

/* Archivo, by Omnibus-Type (Buenos Aires). Self-hosted: no request ever
   leaves for a font CDN, so no visitor IP is handed to a third party.
   Licence in assets/fonts/OFL.txt. */
@font-face {
  font-family: 'Archivo';
  src: url('assets/fonts/archivo-latin.woff2') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
    U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Archivo';
  src: url('assets/fonts/archivo-latin-ext.woff2') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308,
    U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
    U+2C60-2C7F, U+A720-A7FF;
}

:root {
  color-scheme: light;

  --accent: {{ site.theme.accent }};
  --accent-fg: {{ site.accentForeground }};

  /* Cool paper and blue-cast greys: the museum is Artigas concrete, not linen. */
  --bg: #eef2f7;
  --surface: {{ site.surface.light }};
  --surface-2: #f5f8fc;
  /* Comes from site.js: the readable-accent calculation needs this exact
     value, so it is defined once there instead of twice. */
  --surface-hover: {{ site.surfaceHover.light }};
  --text: #0c1220;
  --muted: #4d5c73;
  --border: #d8e0ec;
  --hairline: #e7ecf4;
  /* Scrim over the backdrop photo. Opaque enough that the picture reads as
     atmosphere and never competes with the page above it. */
  --scrim-top: rgba(238, 242, 247, 0.5);
  --scrim-bottom: rgba(238, 242, 247, 0.9);
  --accent-text: {{ site.accentText.light }};
  --focus: {{ site.focusRing.light }};

  /* Depth is a scale, not one shadow reused everywhere. Tinted with the ink
     of the palette so shadows belong to the page instead of greying it. */
  --shadow-1: 0 1px 2px rgba(12, 18, 32, 0.06);
  --shadow-2: 0 2px 4px rgba(12, 18, 32, 0.05), 0 8px 20px rgba(12, 18, 32, 0.06);
  --shadow-3: 0 4px 10px rgba(12, 18, 32, 0.06), 0 24px 60px rgba(12, 18, 32, 0.1);
  /* Top-edge highlight: what makes a raised surface read as lit from above. */
  --ring: inset 0 1px 0 rgba(255, 255, 255, 0.9);

  --display: 'Archivo', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  /* Archivo sets a narrow word space for its width; without this, titles read
     as one long word at display sizes. */
  --display-word-spacing: 0.06em;
  --body: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

{% set darkTokens %}
  color-scheme: dark;
  --bg: #060a13;
  --surface: {{ site.surface.dark }};
  --surface-2: #121c2f;
  --surface-hover: {{ site.surfaceHover.dark }};
  --text: #e9eff8;
  --muted: #9db0cb;
  --border: #22304a;
  --hairline: #1a2438;
  --scrim-top: rgba(6, 10, 19, 0.58);
  --scrim-bottom: rgba(6, 10, 19, 0.93);
  --accent-text: {{ site.accentText.dark }};
  --focus: {{ site.focusRing.dark }};
  --shadow-1: 0 1px 2px rgba(0, 0, 0, 0.5);
  --shadow-2: 0 2px 4px rgba(0, 0, 0, 0.45), 0 8px 20px rgba(0, 0, 0, 0.5);
  --shadow-3: 0 4px 10px rgba(0, 0, 0, 0.5), 0 24px 60px rgba(0, 0, 0, 0.6);
  --ring: inset 0 1px 0 rgba(255, 255, 255, 0.07);
{% endset %}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    {{- darkTokens -}}
  }
}

:root[data-theme='dark'] {
  {{- darkTokens -}}
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

/*
  O atributo hidden esconde via display:none da folha do navegador, que
  qualquer display numa classe sobrepõe. Sem esta regra, os botões que nascem
  escondidos e só o script revela apareciam para quem está sem JavaScript,
  ocupando espaço e não fazendo nada.
*/
[hidden] {
  display: none !important;
}

body {
  margin: 0;
  padding: 1.25rem 0.875rem 3rem;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  font-size: 1rem;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}

/* The museum itself, out of focus, behind everything.
   The blur is baked into the file rather than applied with filter: blur(),
   which would make the compositor re-blur a full-viewport layer on every
   scroll. Fixed, so it stays put while the page moves over it.
   The scrim is painted in the same declaration, above the photo. */
.backdrop {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: linear-gradient(var(--scrim-top), var(--scrim-bottom)),
    url('assets/fundo-museu.webp');
  background-size: cover, cover;
  background-position: center, center;
  /* If the photo never arrives, the scrim alone still matches --bg. */
  background-color: var(--bg);
}

/* Keyboard users get here first; it stays off-screen until focused. */
.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  padding: 0.75rem 1rem;
  background: var(--surface);
  color: var(--text);
  border-radius: 0 0 0.5rem 0;
  box-shadow: var(--shadow-2);
}

.skip-link:focus {
  left: 0;
  z-index: 3;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ---------------------------------------------------------------- toggle -- */

/* Ancorados no cartão, não na viewport. Fixos no canto da tela eles montavam
   na borda arredondada do cartão em qualquer largura de celular, e por serem
   fixos ficavam ali cobrindo conteúdo o scroll inteiro. */
.acoes {
  position: absolute;
  top: 0.625rem;
  right: 0.625rem;
  display: flex;
  gap: 0.375rem;
}

/* Com a faixa no topo, os botões desciam em cima do letreiro do museu: em
   tela de celular a foto ocupa a largura toda e o nome chega perto do canto.
   Aqui eles saem do posicionamento absoluto, entram na grade do cabeçalho
   depois da faixa e sobem só o suficiente para montar na beirada de baixo
   dela, onde a foto é prédio e não letra. */
.profile--hero .hero {
  order: -1;
}

.profile--hero .acoes {
  position: static;
  justify-self: end;
  margin: -2.125rem 0 0;
}

.theme-toggle {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
  color: var(--muted);
  box-shadow: var(--shadow-2), var(--ring);
  cursor: pointer;
}

.theme-toggle:hover {
  color: var(--text);
  background: var(--surface-hover);
}

/* ----------------------------------------------------------------- frame -- */

/* The one surface that lifts off the dot field. Everything inside it is flat
   by default, so the page has a single, readable elevation story. */
.frame {
  position: relative;
  width: 100%;
  max-width: 46rem;
  margin: 0 auto;
  /* Em variável porque a faixa do topo sangra até a borda do cartão e precisa
     desta medida exata como margem negativa. Dois números soltos acabariam
     divergindo na primeira vez que alguém mexesse no espaçamento. */
  --pad-x: 1.125rem;
  --pad-top: 1.5rem;
  --raio: 1.5rem;
  padding: var(--pad-top) var(--pad-x) 1.25rem;
  border: 1px solid var(--border);
  border-radius: var(--raio);
  background: var(--surface);
  box-shadow: var(--shadow-3), var(--ring);
}

/* -------------------------------------------------------------- masthead -- */

.profile {
  display: grid;
  justify-items: center;
  gap: 0.5rem;
  text-align: center;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--hairline);
}

/* A faixa do topo. Sangra até a borda do cartão: um retrato do museu com
   margem dos dois lados viraria mais um cartãozinho dentro do cartão, e o que
   se quer aqui é que a foto seja a beirada de cima da página.

   O raio desconta 1px para encostar por dentro da borda do cartão. Sem isso
   sobra um fio claro entre a foto e a borda em cada canto de cima. */
.hero {
  /* Largura explícita, e não justify-self: stretch. Numa imagem, width: auto
     vale a largura intrínseca do arquivo, que aqui é 1600px: a faixa vazava do
     cartão e empurrava a página inteira para o lado. */
  display: block;
  width: calc(100% + 2 * var(--pad-x));
  /* Sem isto o atributo height do HTML fixa a altura em 800px e a faixa vira
     um bloco quase quadrado que corta o letreiro nas laterais. Os atributos
     continuam no HTML, que é o que reserva o espaço antes da imagem carregar. */
  height: auto;
  margin: calc(-1 * var(--pad-top)) calc(-1 * var(--pad-x)) 0.25rem;
  /* A imagem entra inteira, na proporção dela: recortar comeria o letreiro em
     baixo ou o logotipo da Prefeitura em cima, e os dois precisam aparecer.

     O teto é folgado de propósito. Na largura máxima do cartão, 46rem, uma
     faixa 16:9 fecha em pouco menos de 26rem; 28rem deixa margem para o
     arquivo ser trocado por outro de proporção parecida sem cortar nada, e só
     entra em ação se alguém subir uma imagem alta demais, quando recortar é
     melhor que ocupar a tela inteira. */
  max-height: 28rem;
  object-fit: cover;
  border-radius: calc(var(--raio) - 1px) calc(var(--raio) - 1px) 0 0;
}

.avatar {
  width: 4rem;
  height: 4rem;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-1);
}

.avatar--circle {
  border-radius: 50%;
  object-fit: cover;
}

/* Logos carry a wordmark that a circle would crop, so they get a box and are
   contained rather than cropped. The plate follows the theme, so a logo with
   its own background fills the box and one without still sits on a surface. */
.avatar--square {
  border-radius: 0.875rem;
  object-fit: contain;
  background: var(--surface);
}

.avatar--initials {
  display: grid;
  place-items: center;
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1.75rem;
  font-weight: 600;
  color: var(--accent-fg);
  background: var(--accent);
  border-color: transparent;
}

h1 {
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: clamp(1.375rem, 5.5vw, 1.75rem);
  font-weight: 600;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.handle {
  margin: -0.375rem 0 0;
  font-size: 0.9375rem;
  overflow-wrap: anywhere;
}

/* Padding grows the target without moving anything: the negative margin
   gives back exactly what the padding takes. */
.handle a {
  display: inline-block;
  padding: 0.6875rem 0.75rem;
  margin: -0.6875rem -0.75rem;
  color: var(--muted);
  text-decoration: none;
}

.handle a:hover {
  color: var(--accent-text);
  text-decoration: underline;
}

.tagline {
  margin: 0;
  max-width: 34rem;
  color: var(--muted);
  font-size: 0.875rem;
  overflow-wrap: anywhere;
}

/* Compact contact row: the agenda below is the point of the page. */
.social ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.125rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* 3rem clears both the 44px minimum and Android's 48dp, which matters more
   here than anywhere else on the page: these are the smallest things on it
   and the page is opened from a phone. */
.social__link {
  display: grid;
  place-items: center;
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  color: var(--muted);
  text-decoration: none;
}

.social__link .icon {
  width: 1.375rem;
  height: 1.375rem;
}

.social__link:hover {
  color: var(--accent-text);
  background: var(--surface-hover);
}

/* --------------------------------------------------------------- horário -- */

/* Quem abre a agenda no celular quer saber duas coisas: o que tem, e se dá
   para ir. Isto responde a segunda, e por isso fica no topo e não no rodapé.

   Plano, como tudo dentro do cartão: separado por um fio, sem caixa nem
   sombra própria. */
.horario {
  width: 100%;
  /* Teto só no celular, onde a linha inteira encostaria nas duas bordas. Em
     tela grande ele sai (veja o bloco responsivo) e o horário passa a ocupar a
     largura do cartão, no mesmo alinhamento das linhas da agenda logo abaixo. */
  max-width: 24rem;
  margin-top: 0.125rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--hairline);
}

.horario__titulo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  margin: 0 0 0.375rem;
  font-family: var(--body);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--muted);
}

.horario__titulo .icon {
  width: 0.9375rem;
  height: 0.9375rem;
  flex: none;
}

.horario__lista {
  margin: 0;
}

/* Dias à esquerda, hora à direita. Centralizado como o resto do cabeçalho, o
   olho teria que procurar cada horário; em duas colunas ele desce a coluna da
   direita e lê tudo de uma vez. */
.horario__faixa {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  gap: 0 1rem;
  padding: 0.3125rem 0;
  text-align: left;
}

.horario__faixa + .horario__faixa {
  border-top: 1px solid var(--hairline);
}

.horario__dias {
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.35;
}

.horario__nota {
  display: block;
  font-size: 0.75rem;
  color: var(--muted);
}

/* tabular-nums: os horários formam uma coluna, e com o "1" estreito da fonte
   proporcional as linhas não se alinhavam entre si. */
.horario__hora {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ---------------------------------------------------------------- agenda -- */

.agenda {
  padding-top: 1rem;
}

.agenda__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
}

/* Botão de assinar a agenda: com rótulo, porque aparece uma vez só. */
.agenda__subscribe {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  min-height: 2.75rem;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  background: var(--surface);
  color: var(--muted);
  font-size: 0.8125rem;
  text-decoration: none;
}



/* Por evento é só o ícone, com rótulo acessível: com texto, cada cartão ganhava
   uma linha inteira e a agenda voltava a caber um evento por tela. O alvo
   continua com 44px. */
/* Coluna da direita: miniatura em cima, botão embaixo. Posição fixa em todo
   cartão, em vez de flutuar no meio da linha de metadados conforme o texto
   quebrava. */
.entry__lado {
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 0.75rem;
}

/* O <summary> nasce com um triângulo e com display: list-item. Os dois saem:
   aqui ele tem que parecer o botão que já era, e o estado aberto ou fechado
   quem conta é o menu que aparece embaixo. */
.entry__calendar {
  display: grid;
  list-style: none;
  cursor: pointer;
  place-items: center;
  width: var(--media);
  height: var(--media);
  /* Piso do alvo de toque, caso --media encolha algum dia. */
  min-width: 2.75rem;
  min-height: 2.75rem;
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  background: var(--surface);
  color: var(--muted);
  text-decoration: none;
}

.agenda__subscribe:hover,
.entry__calendar:hover {
  color: var(--accent-text);
  border-color: var(--accent-text);
  background: var(--surface-hover);
}

.agenda__title,
.more__title {
  margin: 0 0 1rem;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1.125rem;
  font-weight: 600;
}

/* Esta seção fecha a página e é curta: centralizada ela lê como um bloco só,
   enquanto a agenda acima precisa do alinhamento à esquerda para a coluna de
   horários guiar a leitura. */
.more__title {
  text-align: center;
}

.empty {
  margin: 0;
  color: var(--muted);
}

/* Day is the unit of the agenda. The date is printed once, on the rail, and
   the entries under it only have to say what time they start. */
.day {
  display: grid;
  grid-template-columns: 2.75rem 1fr;
  gap: 0.875rem;
}

.day + .day {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--hairline);
}

.day__rail {
  position: sticky;
  top: 0.75rem;
  align-self: start;
  margin: 0.75rem 0 0;
  display: grid;
  justify-items: center;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  line-height: 1.05;
  color: var(--muted);
}

.day__weekday,
.day__month {
  font-size: 0.6875rem;
  font-weight: 600;
}

.day__number {
  font-size: 1.5rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.day__entries {
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Rows, not cards: hairlines carry the rhythm, so fourteen events stay
   scannable instead of becoming fourteen identical boxes. */
.entry {
  /* Foto e botão de calendário leem daqui, então não têm como divergir de
     tamanho quando um dos dois for ajustado. */
  --media: 3rem;
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.875rem;
  padding: 0.625rem;
  align-items: start;
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  background: var(--surface);
  box-shadow: var(--shadow-1);
}

.entry + .entry {
  margin-top: 0.5rem;
}



.entry:hover {
  border-color: var(--accent-text);
}

.entry__text {
  min-width: 0;
}

.entry__time {
  margin: 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 0.8125rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--accent-text);
}

.entry__title {
  margin: 0.125rem 0 0;
  font-family: var(--display);
  word-spacing: var(--display-word-spacing);
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

/* O título é a ação principal do cartão, então precisa caber num polegar. O
   preenchimento leva o alvo aos 44px mesmo quando o título tem uma linha só, e
   a margem negativa devolve o espaço para o layout não mudar. */
.entry__link {
  display: block;
  padding: 0.875rem 0;
  margin: -0.875rem 0;
  color: inherit;
  text-decoration: none;
}

.entry__link:hover {
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

/* O cartão inteiro abre o evento: a camada do título cobre a área toda, então
   qualquer ponto funciona, não só as duas linhas do texto.

   O botão de calendário sobe acima dessa camada e continua recebendo o próprio
   clique. Ele tem 48px de lado, então é alvo de sobra, ao contrário do link de
   texto miúdo que ocupava esse papel antes. No DOM os dois são irmãos, e não um
   dentro do outro, então o leitor de tela encontra dois links distintos. */
.entry__link::after {
  content: '';
  position: absolute;
  inset: 0;
}

.entry__calendar::-webkit-details-marker {
  display: none;
}

/* Sobe acima da camada que faz o cartão inteiro abrir o evento, senão o clique
   no botão abriria o evento em vez do menu.

   A caixa do <details> é quadrada e a do botão é arredondada, então sobra uma
   lasca em cada canto. Sem o pointer-events, essa lasca ficava por cima da
   camada do cartão e virava o único ponto do evento que não levava a lugar
   nenhum. Transparente ao ponteiro, ela devolve o clique ao cartão; quem
   recebe são os filhos. */
.entry__cal {
  position: relative;
  z-index: 1;
  pointer-events: none;
}

.entry__cal > * {
  pointer-events: auto;
}

/* Ancorado pela direita: o botão fica na beirada do cartão, e um menu que
   crescesse para a direita sairia da tela no celular. */
/* O display fica no estado aberto, e não aqui. Declarado solto, ele passava
   por cima do que o navegador usa para esconder o conteúdo de um <details>
   fechado, e o menu continuava ocupando caixa mesmo invisível. */
.entry__cal-menu {
  position: absolute;
  top: calc(100% + 0.375rem);
  right: 0;
  z-index: 2;
  min-width: 10.5rem;
  padding: 0.25rem;
  border: 1px solid var(--border);
  border-radius: 0.625rem;
  background: var(--surface);
  box-shadow: var(--shadow-2), var(--ring);
}

.entry__cal[open] > .entry__cal-menu {
  display: grid;
}

/* 2,75rem de piso: são os 44px de alvo de toque que o resto da página
   respeita, e o menu é justamente o que se usa com o polegar. */
.entry__cal-item {
  display: flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0.375rem 0.625rem;
  border-radius: 0.4375rem;
  color: var(--text);
  font-size: 0.875rem;
  text-align: left;
  text-decoration: none;
  white-space: nowrap;
}

.entry__cal-item:hover {
  color: var(--accent-text);
  background: var(--surface-hover);
}

/* Aberto, o botão fica marcado: sem isso, com dois cartões na tela, não dá
   para saber de qual evento é o menu que está aberto. */
.entry__cal[open] > .entry__calendar {
  color: var(--accent-text);
  border-color: var(--accent-text);
  background: var(--surface-hover);
}

/* O cartão é um botão grande, e o cursor precisa dizer isso em toda a área. */
.entry {
  cursor: pointer;
}

/* O menu passa por cima dos cartões vizinhos, e não por baixo. */
.entry:has(.entry__cal[open]) {
  z-index: 3;
}

/* Space alone separates the two parts. A rule or a dot between them lands at
   the start of a line whenever the row wraps, which it does on a phone. */
.entry__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.125rem 0.875rem;
  margin: 0.25rem 0 0;
  font-size: 0.8125rem;
  color: var(--muted);
}


.entry__until {
  font-weight: 600;
}

.entry__media {
  /* A coluna da mídia vem depois no DOM e pinta acima da camada do link, então
     sem isto o clique em cima da foto não chegava a lugar nenhum. */
  pointer-events: none;
  overflow: hidden;
  width: var(--media);
  height: var(--media);
  border-radius: 0.5rem;
  background: var(--surface-hover);
  box-shadow: var(--shadow-1), var(--ring);
}

.entry__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.entry__description {
  margin: 0.5rem 0 0;
  font-size: 0.875rem;
  color: var(--muted);
  /* No line clamp: an explanation cut off mid-word explains nothing, and the
     text is short enough to run in full. */
}

/* ----------------------------------------------------------------- links -- */

.more {
  margin-top: 1.75rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--hairline);
}

.links {
  perspective: 800px;
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.5rem;
}

.link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  min-height: 2.875rem;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--border);
  border-radius: 0.625rem;
  background: var(--surface);
  color: inherit;
  font-size: 0.9375rem;
  text-decoration: none;
}

.link:hover {
  background: var(--surface-hover);
  border-color: var(--accent-text);
}

.link--highlight {
  background: var(--accent);
  border-color: transparent;
  color: var(--accent-fg);
  box-shadow: var(--shadow-2);
}

.link--highlight:hover {
  background: var(--accent);
  border-color: transparent;
  filter: brightness(0.94);
}

.link__label {
  font-weight: 500;
  overflow-wrap: anywhere;
}

/* ---------------------------------------------------------------- footer -- */

.footer {
  margin-top: 1rem;
  padding-top: 1.125rem;
  border-top: 1px solid var(--hairline);
  text-align: center;
}

.footer__inner {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  color: var(--muted);
  font-size: 0.8125rem;
  text-decoration: none;
}

/* No hover here on purpose: the seal is a credit, not a call to action.
   :focus-visible still applies, so keyboard users keep their indicator. */

.footer__logos {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

/* Fixed box, image contained inside it: the slot is reserved before the
   image loads, so no layout shift, whatever logo the config points at. */
.footer__logo {
  width: 5.5rem;
  height: 2.5rem;
  object-fit: contain;
  /* The city mark is dark artwork on transparency; it needs a light plate to
     stay legible when the page renders dark. */
  background: #ffffff;
  border-radius: 0.25rem;
  padding: 0.25rem 0.5rem;
  box-sizing: content-box;
}

/* ----------------------------------------------------------------- icons -- */

.icon {
  flex: none;
  fill: currentColor;
}

.icon--stroke {
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
  border-radius: 0.25rem;
}

/* ------------------------------------------------------------ responsive -- */

@media (min-width: 34rem) {
  body {
    padding: 2.5rem 1.5rem 4rem;
  }

  .frame {
    --pad-x: 1.75rem;
    --pad-top: 1.75rem;
    padding: var(--pad-top) var(--pad-x) 1.5rem;
  }

  .acoes {
    top: 0.875rem;
    right: 0.875rem;
  }

  .avatar {
    width: 5rem;
    height: 5rem;
  }

  .horario {
    max-width: none;
    padding-top: 0.875rem;
  }

  .horario__faixa {
    padding: 0.4375rem 0;
  }

  .horario__dias,
  .horario__hora {
    font-size: 0.9375rem;
  }

  .day {
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
  }

  .entry {
    padding: 0.75rem;
  }

  .entry__title {
    font-size: 1.0625rem;
  }

  .entry {
    --media: 4rem;
  }

}

/* ---------------------------------------------------------------- motion -- */

/*
  Scroll-linked, not time-linked: nothing moves on its own, every frame is a
  function of where the element sits in the viewport. Behind @supports because
  scroll-driven animations are recent, and behind reduced-motion because a
  reader who asked for stillness gets it.

  The photo drifts inside a frame that clips it, so near and far layers travel
  at different rates, which is what parallax actually is. The scale keeps the
  image larger than its frame so the drift never exposes an edge.
*/
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    /* The timeline is named on the frame, not taken from the image. The frame
       clips with overflow:hidden, which makes it a scroll container, so an
       image asking for view() would measure itself against the frame it never
       moves inside, and sit frozen at 50% forever. */
    .entry__media {
      view-timeline-name: --entry-media;
    }

    .entry__image {
      animation: drift linear both;
      animation-timeline: --entry-media;
      animation-range: cover 0% cover 100%;
    }

    .link {
      animation: lift linear both;
      animation-timeline: view();
      animation-range: entry 15% cover 35%;
    }
  }
}

@keyframes drift {
  from {
    transform: translateY(-7%) scale(1.2);
  }

  to {
    transform: translateY(7%) scale(1.2);
  }
}

@keyframes lift {
  from {
    transform: translateY(12px);
    box-shadow: none;
  }

  to {
    transform: none;
    box-shadow: var(--shadow-2);
  }
}

@media (prefers-reduced-motion: no-preference) {
  .link,
  .social__link,
  .theme-toggle,
  .entry,
  .entry__link {
    transition: transform 180ms ease, translate 180ms ease, rotate 180ms ease,
      box-shadow 180ms ease, background-color 150ms ease, color 150ms ease,
      border-color 150ms ease, filter 150ms ease;
  }

  .entry__media {
    transition: transform 300ms ease;
  }
}

/*
  Depth on hover: the surface tips towards the pointer and lifts, and the
  shadow deepens with it, so the movement reads as the card coming off the
  page rather than sliding across it.

  Gated on `hover: hover` so a touch screen, which fires hover on tap and then
  keeps it, never leaves an element stuck mid-tilt, and on
  reduced-motion so a reader who asked for stillness keeps it.
*/
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .entry:hover {
    transform: perspective(900px) rotateX(2deg) translateY(-3px);
    box-shadow: var(--shadow-2);
  }

  /* The photo pushes further forward than its frame: near and far move by
     different amounts, which is what makes it read as depth. */
  .entry:hover .entry__media {
    transform: perspective(900px) translateZ(14px) scale(1.03);
  }

  /* Com o menu de calendário aberto, o cartão para de inclinar. Um transform
     cria contexto de empilhamento, e dentro dele nenhum z-index do menu
     alcança o cartão seguinte: o menu era cortado ao meio pelo evento de
     baixo. Parar a inclinação também é o certo visualmente, porque um menu
     de leitura não deveria estar tombado junto com o cartão. */
  .entry:has(.entry__cal[open]):hover,
  .entry:has(.entry__cal[open]):hover .entry__media {
    transform: none;
  }

  /* The link already runs the scroll-driven `lift` animation, and an animation
     beats a normal :hover rule in the cascade, so a `transform` here would
     never apply. `translate` and `rotate` are separate properties that compose
     with the animation's transform instead of competing with it. */
  .link:hover {
    translate: 0 -3px;
    rotate: x 3deg;
    box-shadow: var(--shadow-2);
  }

  .social__link:hover,
  .theme-toggle:hover {
    transform: perspective(500px) translateZ(10px);
    box-shadow: var(--shadow-2);
  }

  /* Pressing puts it back down, so the click has somewhere to land. */
  .entry:active,
  .social__link:active,
  .theme-toggle:active {
    transform: translateY(0) scale(0.995);
    box-shadow: var(--shadow-1);
  }

  .link:active {
    translate: 0 0;
    rotate: none;
    box-shadow: var(--shadow-1);
  }
}
