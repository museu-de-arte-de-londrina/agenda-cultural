{
  "name": "agenda-cultural",
  "version": "1.0.0",
  "private": false,
  "description": "Agregador de links estatico, editavel por um unico config.yaml, publicado no GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-config.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "build": "npm run validate && eleventy",
    "dev": "eleventy --serve",
    "lighthouse": "npm run build && node scripts/lighthouse.js",
    "test:browser": "npm run build && node --test \"test/browser/*.test.js\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.31.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "linktree",
    "eleventy",
    "github-pages",
    "static-site",
    "yaml"
  ]
}
